{
  "openapi": "3.1.0",
  "info": {
    "title": "CalCraft API",
    "version": "1",
    "description": "REST API of CalCraft. Authenticate with POST /v1/auth/login; the session is a cookie. Every state-changing request needs the x-calcraft-request header (CSRF protection).",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    }
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/v1/version": {
      "get": {
        "summary": "Server name, version and source code location",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/methods": {
      "get": {
        "summary": "Available login methods (password, single sign-on)",
        "description": "Lets the UI decide whether to show an SSO button.",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Login methods",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMethods"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Log in; sets the session cookie",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/Csrf"
          }
        ]
      }
    },
    "/v1/auth/oidc/login": {
      "get": {
        "summary": "Start single sign-on (OpenID Connect)",
        "description": "Browser navigation, not an XHR call. Redirects to the identity provider (Authorization Code flow with PKCE) and sets a short-lived cookie that binds the login to this browser. 404 if SSO is not configured.",
        "tags": [
          "auth"
        ],
        "responses": {
          "303": {
            "description": "Redirect to the identity provider, or to /?sso_error=unavailable",
            "headers": {
              "Location": {
                "description": "Target URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/oidc/callback": {
      "get": {
        "summary": "Single sign-on callback (redirect URI)",
        "description": "Called by the browser when the identity provider redirects back. Validates state, browser binding, code and ID token, maps the identity to a local account, sets the session cookie and redirects to /. On failure redirects to /?sso_error=CODE with CODE one of invalid_request, denied, unavailable, login_failed, no_account, account_exists (existing local account not approved for this IdP subject), local_2fa_required. 404 if SSO is not configured.",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "iss",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "RFC 9207 issuer identifier; must match the configured issuer if present"
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to / (logged in, Set-Cookie with the session) or to /?sso_error=CODE",
            "headers": {
              "Location": {
                "description": "Target URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "End the current session",
        "tags": [
          "auth"
        ],
        "responses": {
          "204": {
            "description": "Logged out"

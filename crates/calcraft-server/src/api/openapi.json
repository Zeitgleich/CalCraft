    "/v1/collections/{kind}/{slug}/export": {
      "get": {
        "summary": "Download a calendar or address book as one file",
        "description": "Streams all objects of the collection. The response has Content-Disposition: attachment. CSV cells starting with =, +, -, @, TAB or CR are prefixed with ' (formula neutralisation).",
        "tags": [
          "collections"
        ],
        "responses": {
          "200": {
            "description": "The file",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"<slug>.<extension>\""
              }
            },
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string"
                }
              },
              "application/calendar+json": {
                "schema": {
                  "type": "string"
                }
              },
              "application/calendar+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "text/vcard": {
                "schema": {
                  "type": "string"
                }
              },
              "application/vcard+json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "calendar",
                "addressbook"
              ]
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "File format. Calendars: ics (default), jcal, xcal, csv. Address books: vcf (default), jcard, csv.",
            "schema": {
              "type": "string",
              "enum": [
                "ics",
                "jcal",
                "xcal",
                "vcf",
                "jcard",
                "csv"
              ]
            }
          }
        ]
      }
    },
    "/v1/collections/{kind}/{slug}/import": {
      "post": {
        "summary": "Import a file into a calendar or address book",
        "description": "The body is the file (at most 20 MiB and server.max_body_bytes, at most 10000 objects). Every object is validated like a DAV PUT; storage quota and object limits apply. Events, to-dos and journals are grouped by UID with their recurrence overrides.",
        "tags": [
          "collections"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/calendar": {
              "schema": {
                "type": "string"
              }
            },
            "application/calendar+json": {
              "schema": {
                "type": "string"
              }
            },
            "application/calendar+xml": {
              "schema": {
                "type": "string"
              }
            },
            "text/vcard": {
              "schema": {
                "type": "string"
              }
            },
            "application/vcard+json": {
              "schema": {
                "type": "string"
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportReport"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Csrf"
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "calendar",
                "addressbook"
              ]
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "File format. Calendars: ics (default), jcal, xcal, csv. Address books: vcf (default), jcard, csv.",
            "schema": {
              "type": "string",
              "enum": [
                "ics",
                "jcal",
                "xcal",
                "vcf",
                "jcard",
                "csv"
              ]
            }
          },
          {
            "name": "on_conflict",
            "in": "query",
            "required": false,
            "description": "What to do when an object with the same UID already exists in the collection.",
            "schema": {
              "type": "string",
              "enum": [
                "skip",
                "replace"
              ],
              "default": "skip"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "calcraft_session"
      }
    },
    "parameters": {
      "Csrf": {
        "name": "x-calcraft-request",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Any value; required on state-changing requests."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "VersionInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "source"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_admin": {
            "type": "boolean"
          },
          "totp_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "username",
          "is_admin",
          "totp_enabled"
        ]
      },
      "ChangePassword": {
        "type": "object",
        "properties": {
          "current": {
            "type": "string"
          },
          "new": {
            "type": "string",
            "minLength": 12
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "current",
          "new"
        ],
        "additionalProperties": false
      },
      "TotpSetup": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          }
        },
        "required": [
          "secret",
          "uri"
        ]
      },
      "TotpEnable": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "RecoveryCodes": {
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "codes"
        ]
      },
      "TotpDisable": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "password",
          "code"
        ],
        "additionalProperties": false
      },
      "AppPasswordInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "last_used_at": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ]
      },
      "CreateAppPassword": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "CreatedAppPassword": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "password"
        ]
      },
      "CollectionInfo": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "calendar",
              "addressbook"
            ]
          },
          "slug": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "href": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "slug",
          "components",
          "href"
        ]
      },
      "CreateCollection": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "calendar",
              "addressbook"
            ]
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
          }
        },
        "required": [
          "kind",
          "slug"
        ],
        "additionalProperties": false
      },
      "UpdateCollection": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_admin": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          },
          "totp_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "username",
          "is_admin",
          "disabled",
          "totp_enabled"
        ]
      },
      "CreateUser": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_admin": {
            "type": "boolean"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "UpdateUser": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "is_admin": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "UpdateInfo": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "current": {
            "type": "string",
            "description": "Version of the running server"
          },
          "latest": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest stable release (X.Y.Z), once a check succeeded"
          },
          "newer": {
            "type": "boolean",
            "description": "latest is newer than current"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Release page below https://github.com/Zeitgleich/CalCraft/releases/"
          },
          "checked_at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Last successful check (Unix seconds)"
          }
        },
        "required": [
          "enabled",
          "current",
          "newer"
        ]
      },
      "AuthMethods": {
        "type": "object",
        "required": [
          "password",
          "oidc"
        ],
        "properties": {
          "password": {
            "type": "boolean",
            "description": "Login with username and password (false if security.password_login is off)"
          },
          "oidc": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OidcMethod"
              },
              {
                "type": "null"
              }
            ],
            "description": "Single sign-on, null if not configured"
          }
        }
      },
      "OidcMethod": {
        "type": "object",
        "required": [
          "label",
          "login_url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Text for the login button"
          },
          "login_url": {
            "type": "string",
            "description": "Relative URL to navigate to",
            "example": "/api/v1/auth/oidc/login"
          }
        }
      },
      "ImportReport": {
        "type": "object",
        "required": [
          "created",
          "replaced",
          "skipped",
          "rejected",
          "errors"
        ],
        "properties": {
          "created": {
            "type": "integer"
          },
          "replaced": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          },
          "rejected": {
            "type": "integer"
          },
          "errors": {
            "type": "array",
            "description": "Reasons for the first 20 rejected objects",
            "items": {
              "$ref": "#/components/schemas/ImportRejection"
            }
          }
        }
      },
      "ImportRejection": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "uid": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}

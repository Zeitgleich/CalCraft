    "/v1/admin/update": {
      "get": {
        "summary": "Result of the optional update check (admins only)",
        "description": "With [updates] check = true the server asks api.github.com for the latest release at startup and every interval_hours (GitHub sees the server's IP address and User-Agent; nothing else is sent). Drafts and pre-releases are ignored. enabled is false when the check is off or not compiled in.",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "Update status",
            "content": {
              "application/json": {
                "schema": {
